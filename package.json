{
  "name": "mycarcost",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user vehicle fuel consumption and expense tracking PWA",
  "workspaces": [
    "frontend",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:worker": "npm run dev --workspace=worker",
    "build:frontend": "npm run build --workspace=frontend",
    "build:worker": "npm run build --workspace=worker",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "fast-check": "^3.22.0"
  }
}
